  m_Name: 
  m_EditorClassIdentifier: 
  infoText: {fileID: 1712844971}
  infoBackground: {fileID: 171457210}
  infoMessage: "8.\tLukisan Realisme \u201CA Bar at the Folies-Berg\xE8re\u201D\r\nKarya
    :  \xC9douard Manet\r\nTahun : 1882\r\nDeskripsi : \nFolies-Bergere adalah sebuah
    pesta di kafe yang populer untuk orang-orang yang modis dan beragam.\r\n\rSuasana
    bar yang semarak tampak dari cermin di belakang sosok sentral, gadis bar yang
    sedih.\r\nMatanya yang cantik dan lelah menghindari kontak dengan penonton yang
    juga berperan ganda sebagai pelanggan dalam adegan ini.\r\n"
