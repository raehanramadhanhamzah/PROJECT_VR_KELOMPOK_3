  m_Script: {fileID: 11500000, guid: 62e883513edff0846b4e3da903a8b407, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  infoText: {fileID: 1712844971}
  infoBackground: {fileID: 171457210}
  infoMessage: "Lukisan Realisme \u201CThe Angelus\u201D\r\nKarya :  Jean-Fran\xE7ois\r\nTahun
    : 1857-1859\r\nDeskripsi : \nLukisan ini menggambarkan seorang pria dan wanita
    petani sedang berdoa di tengah ladang.\r\nUntuk mendukung suasana, di kejauhan
    tampak menara lonceng gereja yang mungkin sedang berbunyi dalam cahaya senja.\r\nLukisan
    ini menggambarkan momen ketenangan dan refleksi rohani yang mendalam di kehidupan
    sehari-hari masyarakat sana.\r"
