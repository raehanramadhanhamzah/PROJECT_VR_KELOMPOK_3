  m_Script: {fileID: 11500000, guid: 62e883513edff0846b4e3da903a8b407, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  infoText: {fileID: 1712844971}
  infoBackground: {fileID: 171457210}
  infoMessage: "Lukisan Realisme \u201CSymphony in White no 1\u201D\r\nKarya : Whistler
    James\r\nTahun : 1862\r\nDeskripsi :\nLukisan ini menggambarkan seorang wanita
    muda, kekasih dan model Whistler, dengan rambut merah panjang tergerai dan mengenakan
    gaun cambric putih sederhana.\r\nDia berdiri di atas permadani kulit beruang
    yang berwarna sama saat dia memegang bunga putih di sisinya, tatapannya yang
    jauh memberinya kualitas seperti boneka.\r\n"
